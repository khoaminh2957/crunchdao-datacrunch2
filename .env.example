# CrunchDAO API key — copy this file to `.env` and paste the real value.
# Create at: https://hub.crunchdao.com → avatar → Settings → API Keys → Generate New Key
# Key is shown ONCE — copy immediately. Format: ck_xxxxxxxxxxxxxxxxxxxxxxxxxx

CRUNCHDAO_API_KEY=ck_your_api_key_here

# Optional: pin the competition slug if you want cron_daily to skip auto-detect.
# Common slugs: datacrunch, adialab-market-forecasting, causality-discovery
# Leave blank to use whatever `crunch setup` configured.
CRUNCHDAO_COMPETITION=
